{
  "name": "@studysphere/desktop",
  "version": "2.0.0",
  "private": true,
  "description": "StudySphere desktop shell (Electron), wraps apps/web.",
  "main": "main.js",
  "scripts": {
    "prepare:web": "node scripts/prepare-desktop.js",
    "icon": "node scripts/create-windows-icon.js",
    "dev": "npm run prepare:web && npm run icon && electron .",
    "windows:installer": "npm run prepare:web && npm run icon && electron-builder --win nsis portable --x64"
  },
  "build": {
    "appId": "com.studysphere.app",
    "productName": "StudySphere",
    "copyright": "Copyright (c) 2026 StudySphere",
    "directories": {
      "output": "../../dist/desktop"
    },
    "files": [
      "main.js",
      "assets/**/*",
      "desktop-web/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/studysphere.ico",
      "signAndEditExecutable": false,
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StudySphere"
    }
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  }
}
